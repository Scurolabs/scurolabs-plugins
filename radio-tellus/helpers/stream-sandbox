#!/usr/bin/bash -p
# Loopback bridge for playback in the isolated network namespace, adapted from
# Radio Atlas's radio-sandbox.
# Copyright (c) 2026 Akshar Patel. Used under the MIT License. See
# THIRD_PARTY_NOTICES.md.
set -euo pipefail

if (( $# < 2 )); then exit 2; fi

script_path=${BASH_SOURCE[0]}
[[ -f $script_path && ! -L $script_path ]] || exit 2
path_safety=$2
[[ -f $path_safety && ! -L $path_safety ]] || exit 2
"$path_safety" "$path_safety" || exit 2
"$path_safety" "$script_path" || exit 2

proxy_socket=$1
shift 2
"$path_safety" "$proxy_socket" || exit 2
bridge_pid=""

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  [[ -z $bridge_pid ]] || kill "$bridge_pid" 2>/dev/null || true
  [[ -z $bridge_pid ]] || wait "$bridge_pid" 2>/dev/null || true
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

setpriv --pdeathsig TERM --no-new-privs socat \
  TCP4-LISTEN:18765,bind=127.0.0.1,reuseaddr,fork,max-children=32 \
  UNIX-CONNECT:"$proxy_socket" >/dev/null 2>&1 &
bridge_pid=$!
for (( attempt = 0; attempt < 100; attempt++ )); do
  if (: > /dev/tcp/127.0.0.1/18765) 2>/dev/null; then break; fi
  kill -0 "$bridge_pid" 2>/dev/null || break
  sleep 0.02
done
kill -0 "$bridge_pid" 2>/dev/null

export http_proxy=http://127.0.0.1:18765
export https_proxy=$http_proxy
export HTTP_PROXY=$http_proxy
export HTTPS_PROXY=$http_proxy
export no_proxy=
export NO_PROXY=
exec setpriv --no-new-privs "$@"
